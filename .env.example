# Serverdagi /opt/ravon-travel/.env uchun namuna. Haqiqiy .env git'ga KIRMAYDI.

# Aloqa/so'rov formalari shu manzilga JSON POST qilinadi (CRM / Telegram ko'prigi).
# Har holda xabarlar /opt/ravon-travel/data/leads.ndjson fayliga ham yoziladi.
LEAD_WEBHOOK_URL=

# Xabarlarni Telegram'ga yuborish: @BotFather'dan olingan bot tokeni va guruh/kanal chat ID'si
# (botni guruhga qo'shing; ID'ni https://api.telegram.org/bot<TOKEN>/getUpdates dan oling).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Click to'lov tizimi (merchant.click.uz → kabinet). Uchalasi (SERVICE_ID, MERCHANT_ID, SECRET_KEY)
# berilganda to'lov sahifasi Click rejimiga o'tadi; bittasi bo'sh bo'lsa — demo rejim (pul yechilmaydi).
# SECRET_KEY maxfiy: faqat shu faylda, git'ga va chatga yozilmaydi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Ixtiyoriy (Merchant API / fiskalizatsiya uchun kerak bo'ladi)
CLICK_MERCHANT_USER_ID=

# Host'dagi localhost porti (nginx shu portga proxy qiladi)
HOST_PORT=3130
